[Unit]
Description=Personal Finance Management App (local)
Documentation=https://github.com/t-develo/personal-finance-management-app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 既定は pi / /opt/kakei。APP_USER や APP_DIR を変えて導入した場合は
# install.sh が /etc/systemd/system/kakei-app.service.d/override.conf
# で上書きする (このファイルはシンボリックリンクで配置され git 追跡下に
# あるため、ここを直接書き換えると自動更新の git merge --ff-only が壊れる)。
User=pi
Group=pi
WorkingDirectory=/opt/kakei/api
# PORT / SQLITE_PATH / LOCAL_USER_ID などはここから読む。
# SQLITE_PATH は必ず /opt/kakei/data/ 配下にすること。
# 下の ReadWritePaths で書き込みを許しているのはこのディレクトリだけで、
# 既定値 (WorkingDirectory/data = /opt/kakei/api/data) は許可範囲の外になる。
EnvironmentFile=/opt/kakei/.env
ExecStart=/usr/bin/node src/local/server.js
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kakei-app

# 最低限のサンドボックス。DB を書けるディレクトリだけ読み書き可にする。
# アプリ自身はコードを書き換えられない (更新は kakei-update.service が行う)。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/kakei/data

[Install]
WantedBy=multi-user.target
