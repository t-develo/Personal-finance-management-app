# ラズパイのローカル稼働用の設定。/opt/kakei/.env にコピーして使う。
# systemd の EnvironmentFile として読み込まれるため、値は引用符で囲まない。

# --- データストア ---
# sqlite = ローカル SQLite / azure = Azure Table Storage (既定)
STORE_BACKEND=sqlite
SQLITE_PATH=/opt/kakei/data/kakei.db

# --- 認証 (固定シングルユーザー) ---
# Azure 稼働時の PartitionKey と同じ値にすること。
# 確認方法: Azure 版にログインした状態でブラウザから /.auth/me を開き userId を見る。
# scripts/export-azure.js の実行ログにも検出された userId が出力される。
LOCAL_USER_ID=CHANGE_ME
LOCAL_USER_DETAILS=me

# --- サーバー ---
PORT=8080
HOST=0.0.0.0
FRONTEND_DIST=/opt/kakei/frontend/dist

# --- その他 ---
TZ=Asia/Tokyo

# --- 移行スクリプト実行時のみ必要 (常時設定は不要) ---
# STORAGE_ACCOUNT_NAME=
# STORAGE_ACCOUNT_KEY=
